{
  "name": "@macle-community/simulator-web",
  "version": "1.0.1",
  "description": "Standalone, zero-electron Web Simulator for Macle MiniPrograms (Taro & Native MAML)",
  "main": "src/server.js",
  "bin": {
    "macle-simulator-web": "src/cli.js",
    "macle-web-simulator": "src/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node src/cli.js --watch",
    "sample": "node src/cli.js -s ../sample-project/dist",
    "opendoc": "node src/cli.js -s ../opendoc/miniapp",
    "test": "node src/cli.js --help"
  },
  "keywords": [
    "macle",
    "miniprogram",
    "simulator",
    "web-simulator",
    "devtools",
    "taro",
    "maml",
    "huawei"
  ],
  "author": "t.tsegaye <t.tsegaye@appdiv.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natiDotnet/macle-simulator-web.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "license": "MIT"
}
